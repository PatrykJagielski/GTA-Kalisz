{
  "name": "gta-kalisz",
  "version": "1.0.0",
  "private": true,
  "description": "Jazda Audi A4 B7 po Kaliszu odtworzonym z danych OpenStreetMap",
  "type": "module",
  "engines": { "node": ">=18" },
